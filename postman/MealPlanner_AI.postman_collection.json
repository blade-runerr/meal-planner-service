{
  "info": {
    "name": "Meal Planner — AI (Mistral) — 10 запросов",
    "description": "Коллекция для этапа 3: профиль → план → GET /plans/{id}/suggestions (Redis + Celery + Mistral). Замените planId после генерации плана.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "userId", "value": "42" },
    { "key": "planId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. POST профиль (подготовка к AI)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-User-Id", "value": "{{userId}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"daily_calories\": 2000,\n  \"excluded_ingredients\": \"сахар\"\n}" },
        "url": "{{baseUrl}}/profiles/"
      }
    },
    {
      "name": "2. POST сгенерировать недельный план",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/generate/"
      }
    },
    {
      "name": "3. GET план по id (поле diversity_score)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/{{planId}}/"
      }
    },
    {
      "name": "4. GET AI suggestions — первый вызов (202 или 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/{{planId}}/suggestions/"
      }
    },
    {
      "name": "5. GET AI suggestions — повтор (кеш Redis, 200)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/{{planId}}/suggestions/"
      }
    },
    {
      "name": "6. GET AI suggestions — проверка структуры ответа",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/{{planId}}/suggestions/"
      }
    },
    {
      "name": "7. POST второй план (другой рацион для AI)",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/generate/"
      }
    },
    {
      "name": "8. GET AI suggestions для planId=2 (поменяйте переменную)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-User-Id", "value": "{{userId}}" }],
        "url": "{{baseUrl}}/plans/2/suggestions/"
      }
    },
    {
      "name": "9. GET OpenAPI schema (документация AI-эндпоинта)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/schema/"
      }
    },
    {
      "name": "10. GET AI suggestions — ошибка 403 (чужой план)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "X-User-Id", "value": "999" }
        ],
        "url": "{{baseUrl}}/plans/{{planId}}/suggestions/"
      }
    }
  ]
}
